# Core
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Production only: origins allowed to submit unsafe requests, e.g. https://app.papertrail.example
CSRF_TRUSTED_ORIGINS=

# Production transport security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Database (PostgreSQL in prod, SQLite default for dev)
DATABASE_URL=sqlite:///db.sqlite3
DB_CONN_MAX_AGE=60

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Storage (Cloudflare R2)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_STORAGE_BUCKET_NAME=
R2_S3_ENDPOINT_URL=
R2_PAPERTRAIL_STORAGE_ACCOUNT_ID=

# OCR
GEMINI_API_KEY=

# Background tasks (Upstash QStash)
QSTASH_TOKEN=
DJANGO_QSTASH_DOMAIN=
DJANGO_QSTASH_WEBHOOK_PATH=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Email (Resend)
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Papertrail <onboarding@resend.dev>

# Web push
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_EMAIL=

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=
# Min seconds between per-item transaction syncs (webhook debounce)
PLAID_SYNC_COOLDOWN_SECONDS=60

# Fernet encryption (Plaid access tokens)
FERNET_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
DJSTRIPE_FOREIGN_KEY_TO_FIELD=id
STRIPE_PRICING_TABLE_ID=
STRIPE_PRICING_TABLE_KEY=

# OAuth providers (allauth)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# PostHog
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_DISABLED=True
